From af35e1fd8ee34d7052d7decda1db2bb4dffbd520 Mon Sep 17 00:00:00 2001
From: sbctl <sbctl@users.noreply.invalid>
Date: Tue, 6 Oct 2026 11:25:27 -0700
Subject: [PATCH 3/3] feat(studio): allow extra project hosts in the platform
 CSP

A deployment that runs its own control plane serves project APIs from its
own domain (for example <ref>.api.example.com). The platform CSP only
allows *.supabase.co and a single NIMBUS_PROD_PROJECTS_URL pair, so the
browser blocks Realtime, Storage and REST calls to those hosts.

Add CSP_EXTRA_PROJECT_HOSTS, a comma- or space-separated list of host
sources that are allowed over https and wss (https for images).
Non-host tokens are dropped so the value cannot inject other
directives.
---
 apps/studio/csp.test.ts | 42 +++++++++++++++++++++++++++++++++++++++++
 apps/studio/csp.ts      | 15 +++++++++++++++
 apps/studio/turbo.jsonc |  1 +
 3 files changed, 58 insertions(+)
 create mode 100644 apps/studio/csp.test.ts

diff --git a/apps/studio/csp.test.ts b/apps/studio/csp.test.ts
new file mode 100644
index 0000000..8799eb6
--- /dev/null
+++ b/apps/studio/csp.test.ts
@@ -0,0 +1,42 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+async function loadCSP() {
+  vi.resetModules()
+  return (await import('./csp')).getCSP()
+}
+
+describe('getCSP', () => {
+  afterEach(() => {
+    vi.unstubAllEnvs()
+  })
+
+  it('does not allow custom project hosts by default', async () => {
+    const csp = await loadCSP()
+    expect(csp).not.toContain('example.com')
+  })
+
+  it('allows CSP_EXTRA_PROJECT_HOSTS over https and wss in connect-src', async () => {
+    vi.stubEnv('CSP_EXTRA_PROJECT_HOSTS', '*.api.example.com, db.example.net:8443')
+    const csp = await loadCSP()
+    const connectSrc = csp.split('; ').find((directive) => directive.startsWith('connect-src'))!
+    expect(connectSrc).toContain('https://*.api.example.com')
+    expect(connectSrc).toContain('wss://*.api.example.com')
+    expect(connectSrc).toContain('https://db.example.net:8443')
+  })
+
+  it('allows extra project hosts for images over https only', async () => {
+    vi.stubEnv('CSP_EXTRA_PROJECT_HOSTS', '*.api.example.com')
+    const csp = await loadCSP()
+    const imgSrc = csp.split('; ').find((directive) => directive.startsWith('img-src'))!
+    expect(imgSrc).toContain('https://*.api.example.com')
+    expect(imgSrc).not.toContain('wss://*.api.example.com')
+  })
+
+  it('drops values that are not plain host sources', async () => {
+    vi.stubEnv('CSP_EXTRA_PROJECT_HOSTS', "evil.com; script-src * 'unsafe-eval',https://x.com,*.ok.example.com")
+    const csp = await loadCSP()
+    expect(csp).not.toContain('evil.com')
+    expect(csp).not.toContain('https://https://')
+    expect(csp).toContain('https://*.ok.example.com')
+  })
+})
diff --git a/apps/studio/csp.ts b/apps/studio/csp.ts
index 65a4b24..4f00a61 100644
--- a/apps/studio/csp.ts
+++ b/apps/studio/csp.ts
@@ -41,6 +41,18 @@ const NIMBUS_STAGING_PROJECTS_URL_WS = 'wss://*.nmb-proj.com'
 const NIMBUS_PROD_PROJECTS_URL = process.env.NIMBUS_PROD_PROJECTS_URL || ''
 const NIMBUS_PROD_PROJECTS_URL_WS = process.env.NIMBUS_PROD_PROJECTS_URL_WS || ''
 
+// Extra hosts that serve project APIs, for deployments that run their own control plane on a
+// custom domain (for example `*.api.example.com`). Comma- or space-separated host sources,
+// without a scheme. Each one is allowed over https and wss. Tokens that are not plain host
+// sources (letters, digits, `.`, `-`, a leading `*.` wildcard and an optional port) are dropped
+// so the value cannot inject other CSP directives.
+const EXTRA_PROJECT_HOST_PATTERN = /^(\*\.)?[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:\d{1,5})?$/i
+const EXTRA_PROJECT_HOSTS = (process.env.CSP_EXTRA_PROJECT_HOSTS ?? '')
+  .split(/[\s,]+/)
+  .filter((host) => EXTRA_PROJECT_HOST_PATTERN.test(host))
+const EXTRA_PROJECTS_URL = EXTRA_PROJECT_HOSTS.map((host) => `https://${host}`)
+const EXTRA_PROJECTS_URL_WS = EXTRA_PROJECT_HOSTS.map((host) => `wss://${host}`)
+
 const SUPABASE_STAGING_PROJECTS_URL = 'https://*.supabase.red https://*.storage.supabase.red'
 const SUPABASE_STAGING_PROJECTS_URL_WS = 'wss://*.supabase.red'
 const SUPABASE_COM_URL = 'https://supabase.com'
@@ -109,6 +121,8 @@ export function getCSP() {
     GOOGLE_MAPS_API_URL,
     POSTHOG_URL,
     ...(!!NIMBUS_PROD_PROJECTS_URL ? [NIMBUS_PROD_PROJECTS_URL, NIMBUS_PROD_PROJECTS_URL_WS] : []),
+    ...EXTRA_PROJECTS_URL,
+    ...EXTRA_PROJECTS_URL_WS,
     CLOUDFLARE_CDN_URL,
   ]
   const SCRIPT_SRC_URLS = [
@@ -146,6 +160,7 @@ export function getCSP() {
     USERCENTRICS_URLS,
     MARKETPLACE_API_URL,
     ...(!!NIMBUS_PROD_PROJECTS_URL ? [NIMBUS_PROD_PROJECTS_URL, NIMBUS_PROD_PROJECTS_URL_WS] : []),
+    ...EXTRA_PROJECTS_URL,
   ]
   const STYLE_SRC_URLS = [CLOUDFLARE_CDN_URL, SUPABASE_ASSETS_URL]
   const FONT_SRC_URLS = [CLOUDFLARE_CDN_URL, SUPABASE_ASSETS_URL]
diff --git a/apps/studio/turbo.jsonc b/apps/studio/turbo.jsonc
index bb57b7c..fa3c5c7 100644
--- a/apps/studio/turbo.jsonc
+++ b/apps/studio/turbo.jsonc
@@ -27,6 +27,7 @@
         "NEXT_PUBLIC_VERCEL_BRANCH_URL",
         "NEXT_PUBLIC_GOOGLE_MAPS_KEY",
         "NEXT_RUNTIME",
+        "CSP_EXTRA_PROJECT_HOSTS",
         "NIMBUS_PROD_PROJECTS_URL",
         "NIMBUS_PROD_PROJECTS_URL_WS",
         "NODE_ENV",

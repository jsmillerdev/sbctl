 import { auth } from '@/lib/gotrue'
@@ -178,19 +179,21 @@ const ForgotPasswordForm = ({ onSuccess }: { onSuccess: (email: string) => void
           )}
         />
 
-        <div className="self-center">
-          <HCaptcha
-            ref={captchaRef}
-            sitekey={process.env.NEXT_PUBLIC_HCAPTCHA_SITE_KEY!}
-            size="invisible"
-            onVerify={(token) => {
-              setCaptchaToken(token)
-            }}
-            onExpire={() => {
-              setCaptchaToken(null)
-            }}
-          />
-        </div>
+        {HCAPTCHA_SITE_KEY && (

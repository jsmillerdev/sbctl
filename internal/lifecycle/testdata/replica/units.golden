PGRST_DB_URI="postgres://authenticator:authenticator-password@127.0.0.1:10021,127.0.0.1:20021/postgres?sslmode=disable&application_name=postgrest-replica&target_session_attrs=read-only"
PGRST_DB_USE_LEGACY_GUCS="false"
PGRST_JWT_SECRET="jwt-secret-for-the-golden-test"

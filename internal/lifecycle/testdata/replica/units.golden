### supavise-postgres@abcdefghijklmnopqrst.service
--- spec
{
  "Service": "postgres",
  "Ref": "abcdefghijklmnopqrst",
  "ArtifactDir": "/art/postgres",
  "WorkDir": "/STATE/projects/abcdefghijklmnopqrst/postgres",
  "Env": {
    "PGDATA": "/STATE/projects/abcdefghijklmnopqrst/postgres/data",
    "PGSODIUM_KEY_FILE": "/STATE/projects/abcdefghijklmnopqrst/postgres/pgsodium_root.key",
    "POSTGRES_DB": "postgres",
    "POSTGRES_USER": "supabase_admin"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": [
    "bin/supabase-postgres-start",
    "-p",
    "10021",
    "-c",
    "listen_addresses=127.0.0.1",
    "-c",
    "unix_socket_directories=/STATE/projects/abcdefghijklmnopqrst/postgres/sock",
    "-c",
    "unix_socket_permissions=0700",
    "-c",
    "hba_file=/STATE/projects/abcdefghijklmnopqrst/postgres/pg_hba.conf",
    "-c",
    "wal_level=logical",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "jit=off",
    "-c",
    "cron.use_background_workers=on",
    "-c",
    "cron.database_name=postgres",
    "-c",
    "cron.max_running_jobs=8",
    "-c",
    "max_worker_processes=16",
    "-c",
    "shared_buffers=256MB",
    "-c",
    "effective_cache_size=768MB",
    "-c",
    "work_mem=4MB",
    "-c",
    "maintenance_work_mem=64MB",
    "-c",
    "max_wal_size=256MB",
    "-c",
    "max_connections=60",
    "-c",
    "max_worker_processes=16",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "max_connections=80",
    "-c",
    "hot_standby=on",
    "-c",
    "hot_standby_feedback=on",
    "-c",
    "archive_mode=on",
    "-c",
    "archive_timeout=900",
    "-c",
    "archive_command='/usr/local/bin/supavise' wal push --ref abcdefghijklmnopqrst --socket '/STATE/projects/abcdefghijklmnopqrst/wal/r.sock' %p"
  ],
  "Log": "",
  "PreStart": null,
  "PublicRun": false,
  "DenyEgress": false
}
--- env
PGDATA="/STATE/projects/abcdefghijklmnopqrst/postgres/data"
PGSODIUM_KEY_FILE="/STATE/projects/abcdefghijklmnopqrst/postgres/pgsodium_root.key"
POSTGRES_DB="postgres"
POSTGRES_USER="supabase_admin"
--- run
#!/bin/sh
# Generated by supavise; changes are overwritten.
set -e
cd '/STATE/projects/abcdefghijklmnopqrst/postgres'
exec '/art/postgres/bin/supabase-postgres-start' '-p' '10021' '-c' 'listen_addresses=127.0.0.1' '-c' 'unix_socket_directories=/STATE/projects/abcdefghijklmnopqrst/postgres/sock' '-c' 'unix_socket_permissions=0700' '-c' 'hba_file=/STATE/projects/abcdefghijklmnopqrst/postgres/pg_hba.conf' '-c' 'wal_level=logical' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'jit=off' '-c' 'cron.use_background_workers=on' '-c' 'cron.database_name=postgres' '-c' 'cron.max_running_jobs=8' '-c' 'max_worker_processes=16' '-c' 'shared_buffers=256MB' '-c' 'effective_cache_size=768MB' '-c' 'work_mem=4MB' '-c' 'maintenance_work_mem=64MB' '-c' 'max_wal_size=256MB' '-c' 'max_connections=60' '-c' 'max_worker_processes=16' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'max_connections=80' '-c' 'hot_standby=on' '-c' 'hot_standby_feedback=on' '-c' 'archive_mode=on' '-c' 'archive_timeout=900' '-c' 'archive_command='\''/usr/local/bin/supavise'\'' wal push --ref abcdefghijklmnopqrst --socket '\''/STATE/projects/abcdefghijklmnopqrst/wal/r.sock'\'' %p'

### supavise-postgrest@abcdefghijklmnopqrst.service
--- spec
{
  "Service": "postgrest",
  "Ref": "abcdefghijklmnopqrst",
  "ArtifactDir": "/art/postgrest",
  "WorkDir": "/STATE/projects/abcdefghijklmnopqrst/postgrest",
  "Env": {
    "PGRST_APP_SETTINGS_JWT_EXP": "3600",
    "PGRST_APP_SETTINGS_JWT_SECRET": "jwt-secret-for-the-golden-test",
    "PGRST_DB_ANON_ROLE": "anon",
    "PGRST_DB_EXTRA_SEARCH_PATH": "public,extensions",
    "PGRST_DB_MAX_ROWS": "1000",
    "PGRST_DB_POOL": "5",
    "PGRST_DB_SCHEMAS": "public,extra",
    "PGRST_DB_URI": "postgres://authenticator:authenticator-password@127.0.0.1:10021,127.0.0.1:20021/postgres?sslmode=disable\u0026application_name=postgrest-replica\u0026target_session_attrs=read-only",
    "PGRST_DB_USE_LEGACY_GUCS": "false",
    "PGRST_JWT_SECRET": "jwt-secret-for-the-golden-test",
    "PGRST_LOG_LEVEL": "warn",
    "PGRST_OPENAPI_SERVER_PROXY_URI": "https://abcdefghijklmnopqrst-rr-us-east-1-abc123.api.example.test/rest/v1",
    "PGRST_SERVER_HOST": "127.0.0.1",
    "PGRST_SERVER_PORT": "10023"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": null,
  "Log": "",
  "PreStart": null,
  "PublicRun": false,
  "DenyEgress": false
}
--- env

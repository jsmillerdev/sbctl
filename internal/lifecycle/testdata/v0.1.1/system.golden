### supavise-postgres@system.service
--- spec
{
  "Service": "postgres",
  "Ref": "system",
  "ArtifactDir": "/art/postgres",
  "WorkDir": "/STATE/projects/system/postgres",
  "Env": {
    "PGDATA": "/STATE/projects/system/postgres/data",
    "PGSODIUM_KEY_FILE": "/STATE/projects/system/postgres/pgsodium_root.key",
    "POSTGRES_DB": "postgres",
    "POSTGRES_PASSWORD": "admin-password",
    "POSTGRES_USER": "supabase_admin"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": [
    "bin/supabase-postgres-start",
    "-p",
    "5433",
    "-c",
    "listen_addresses=127.0.0.1",
    "-c",
    "unix_socket_directories=/STATE/projects/system/postgres/sock",
    "-c",
    "unix_socket_permissions=0700",
    "-c",
    "hba_file=/STATE/projects/system/postgres/pg_hba.conf",
    "-c",
    "wal_level=logical",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "jit=off",
    "-c",
    "cron.use_background_workers=on",
    "-c",
    "cron.database_name=postgres",
    "-c",
    "cron.max_running_jobs=8",
    "-c",
    "max_worker_processes=16",
    "-c",
    "shared_buffers=64MB",
    "-c",
    "effective_cache_size=256MB",
    "-c",
    "work_mem=4MB",
    "-c",
    "maintenance_work_mem=32MB",
    "-c",
    "max_wal_size=512MB",
    "-c",
    "max_connections=100",
    "-c",
    "max_worker_processes=16",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "archive_mode=on",
    "-c",
    "archive_timeout=900",
    "-c",
    "archive_command='/usr/local/bin/supavise' wal push --ref system --socket '/STATE/projects/system/wal/r.sock' %p"
  ],
  "Log": "",
  "PreStart": null,
  "PublicRun": false,
  "DenyEgress": false
}
--- env
PGDATA="/STATE/projects/system/postgres/data"
PGSODIUM_KEY_FILE="/STATE/projects/system/postgres/pgsodium_root.key"
POSTGRES_DB="postgres"
POSTGRES_PASSWORD="admin-password"
POSTGRES_USER="supabase_admin"
--- run
#!/bin/sh
# Generated by supavise; changes are overwritten.
set -e
cd '/STATE/projects/system/postgres'
exec '/art/postgres/bin/supabase-postgres-start' '-p' '5433' '-c' 'listen_addresses=127.0.0.1' '-c' 'unix_socket_directories=/STATE/projects/system/postgres/sock' '-c' 'unix_socket_permissions=0700' '-c' 'hba_file=/STATE/projects/system/postgres/pg_hba.conf' '-c' 'wal_level=logical' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'jit=off' '-c' 'cron.use_background_workers=on' '-c' 'cron.database_name=postgres' '-c' 'cron.max_running_jobs=8' '-c' 'max_worker_processes=16' '-c' 'shared_buffers=64MB' '-c' 'effective_cache_size=256MB' '-c' 'work_mem=4MB' '-c' 'maintenance_work_mem=32MB' '-c' 'max_wal_size=512MB' '-c' 'max_connections=100' '-c' 'max_worker_processes=16' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'archive_mode=on' '-c' 'archive_timeout=900' '-c' 'archive_command='\''/usr/local/bin/supavise'\'' wal push --ref system --socket '\''/STATE/projects/system/wal/r.sock'\'' %p'

### supavise-gotrue@system.service
--- spec
{
  "Service": "gotrue",
  "Ref": "system",
  "ArtifactDir": "/art/gotrue",
  "WorkDir": "/STATE/projects/system/gotrue",
  "Env": {
    "API_EXTERNAL_URL": "https://api.example.test/auth/v1",
    "DATABASE_URL": "postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:5433/postgres?sslmode=disable",
    "GOTRUE_API_HOST": "127.0.0.1",
    "GOTRUE_API_PORT": "9999",
    "GOTRUE_DB_DATABASE_URL": "postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:5433/postgres?sslmode=disable",
    "GOTRUE_DB_DRIVER": "postgres",
    "GOTRUE_DB_MAX_POOL_SIZE": "5",
    "GOTRUE_DISABLE_SIGNUP": "true",
    "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
    "GOTRUE_JWT_ADMIN_ROLES": "service_role",
    "GOTRUE_JWT_AUD": "authenticated",
    "GOTRUE_JWT_DEFAULT_GROUP_NAME": "authenticated",
    "GOTRUE_JWT_EXP": "3600",
    "GOTRUE_JWT_ISSUER": "https://api.example.test/auth/v1",
    "GOTRUE_JWT_SECRET": "jwt-secret-for-the-golden-test",
    "GOTRUE_LOG_LEVEL": "warn",
    "GOTRUE_MAILER_AUTOCONFIRM": "true",
    "GOTRUE_MAILER_URLPATHS_CONFIRMATION": "https://api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": "https://api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_INVITE": "https://api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_RECOVERY": "https://api.example.test/auth/v1/verify",
    "GOTRUE_SITE_URL": "https://studio.example.test"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": null,
  "Log": "",
  "PreStart": [
    [
      "bin/auth",
      "migrate"
    ]
  ],
  "PublicRun": false,
  "DenyEgress": false
}
--- env
API_EXTERNAL_URL="https://api.example.test/auth/v1"
DATABASE_URL="postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:5433/postgres?sslmode=disable"
GOTRUE_API_HOST="127.0.0.1"
GOTRUE_API_PORT="9999"
GOTRUE_DB_DATABASE_URL="postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:5433/postgres?sslmode=disable"
GOTRUE_DB_DRIVER="postgres"
GOTRUE_DB_MAX_POOL_SIZE="5"
GOTRUE_DISABLE_SIGNUP="true"
GOTRUE_EXTERNAL_EMAIL_ENABLED="true"
GOTRUE_JWT_ADMIN_ROLES="service_role"
GOTRUE_JWT_AUD="authenticated"
GOTRUE_JWT_DEFAULT_GROUP_NAME="authenticated"
GOTRUE_JWT_EXP="3600"
GOTRUE_JWT_ISSUER="https://api.example.test/auth/v1"
GOTRUE_JWT_SECRET="jwt-secret-for-the-golden-test"
GOTRUE_LOG_LEVEL="warn"
GOTRUE_MAILER_AUTOCONFIRM="true"
GOTRUE_MAILER_URLPATHS_CONFIRMATION="https://api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE="https://api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_INVITE="https://api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_RECOVERY="https://api.example.test/auth/v1/verify"
GOTRUE_SITE_URL="https://studio.example.test"
--- run
#!/bin/sh
# Generated by supavise; changes are overwritten.
set -e
cd '/STATE/projects/system/gotrue'
'/art/gotrue/bin/auth' 'migrate'
exec '/art/gotrue/bin/auth'


### supavise-postgres@zyxwvutsrqponmlkjihg.service
--- spec
{
  "Service": "postgres",
  "Ref": "zyxwvutsrqponmlkjihg",
  "ArtifactDir": "/art/postgres",
  "WorkDir": "/STATE/projects/zyxwvutsrqponmlkjihg/postgres",
  "Env": {
    "PGDATA": "/STATE/projects/zyxwvutsrqponmlkjihg/postgres/data",
    "PGSODIUM_KEY_FILE": "/STATE/projects/zyxwvutsrqponmlkjihg/postgres/pgsodium_root.key",
    "POSTGRES_DB": "postgres",
    "POSTGRES_PASSWORD": "admin-password",
    "POSTGRES_USER": "supabase_admin"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": [
    "bin/supabase-postgres-start",
    "-p",
    "20033",
    "-c",
    "listen_addresses=127.0.0.1",
    "-c",
    "unix_socket_directories=/STATE/projects/zyxwvutsrqponmlkjihg/postgres/sock",
    "-c",
    "unix_socket_permissions=0700",
    "-c",
    "hba_file=/STATE/projects/zyxwvutsrqponmlkjihg/postgres/pg_hba.conf",
    "-c",
    "wal_level=logical",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "jit=off",
    "-c",
    "cron.use_background_workers=on",
    "-c",
    "cron.database_name=postgres",
    "-c",
    "cron.max_running_jobs=8",
    "-c",
    "max_worker_processes=16",
    "-c",
    "shared_buffers=256MB",
    "-c",
    "effective_cache_size=768MB",
    "-c",
    "work_mem=4MB",
    "-c",
    "maintenance_work_mem=64MB",
    "-c",
    "max_wal_size=256MB",
    "-c",
    "max_connections=60",
    "-c",
    "max_worker_processes=16",
    "-c",
    "max_wal_senders=5",
    "-c",
    "max_replication_slots=5",
    "-c",
    "max_connections=80",
    "-c",
    "shared_buffers=64MB",
    "-c",
    "archive_mode=on",
    "-c",
    "archive_timeout=300",
    "-c",
    "archive_command='/usr/local/bin/supavise' wal push --ref zyxwvutsrqponmlkjihg --socket '/STATE/projects/zyxwvutsrqponmlkjihg/wal/r.sock' %p"
  ],
  "Log": "",
  "PreStart": null,
  "PublicRun": false,
  "DenyEgress": true
}
--- env
PGDATA="/STATE/projects/zyxwvutsrqponmlkjihg/postgres/data"
PGSODIUM_KEY_FILE="/STATE/projects/zyxwvutsrqponmlkjihg/postgres/pgsodium_root.key"
POSTGRES_DB="postgres"
POSTGRES_PASSWORD="admin-password"
POSTGRES_USER="supabase_admin"
--- run
#!/bin/sh
# Generated by supavise; changes are overwritten.
set -e
cd '/STATE/projects/zyxwvutsrqponmlkjihg/postgres'
exec '/art/postgres/bin/supabase-postgres-start' '-p' '20033' '-c' 'listen_addresses=127.0.0.1' '-c' 'unix_socket_directories=/STATE/projects/zyxwvutsrqponmlkjihg/postgres/sock' '-c' 'unix_socket_permissions=0700' '-c' 'hba_file=/STATE/projects/zyxwvutsrqponmlkjihg/postgres/pg_hba.conf' '-c' 'wal_level=logical' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'jit=off' '-c' 'cron.use_background_workers=on' '-c' 'cron.database_name=postgres' '-c' 'cron.max_running_jobs=8' '-c' 'max_worker_processes=16' '-c' 'shared_buffers=256MB' '-c' 'effective_cache_size=768MB' '-c' 'work_mem=4MB' '-c' 'maintenance_work_mem=64MB' '-c' 'max_wal_size=256MB' '-c' 'max_connections=60' '-c' 'max_worker_processes=16' '-c' 'max_wal_senders=5' '-c' 'max_replication_slots=5' '-c' 'max_connections=80' '-c' 'shared_buffers=64MB' '-c' 'archive_mode=on' '-c' 'archive_timeout=300' '-c' 'archive_command='\''/usr/local/bin/supavise'\'' wal push --ref zyxwvutsrqponmlkjihg --socket '\''/STATE/projects/zyxwvutsrqponmlkjihg/wal/r.sock'\'' %p'

### supavise-gotrue@zyxwvutsrqponmlkjihg.service
--- spec
{
  "Service": "gotrue",
  "Ref": "zyxwvutsrqponmlkjihg",
  "ArtifactDir": "/art/gotrue",
  "WorkDir": "/STATE/projects/zyxwvutsrqponmlkjihg/gotrue",
  "Env": {
    "API_EXTERNAL_URL": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1",
    "DATABASE_URL": "postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:20033/postgres?sslmode=disable",
    "GOTRUE_API_HOST": "127.0.0.1",
    "GOTRUE_API_PORT": "20034",
    "GOTRUE_DB_DATABASE_URL": "postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:20033/postgres?sslmode=disable",
    "GOTRUE_DB_DRIVER": "postgres",
    "GOTRUE_DISABLE_SIGNUP": "false",
    "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
    "GOTRUE_JWT_ADMIN_ROLES": "service_role",
    "GOTRUE_JWT_AUD": "authenticated",
    "GOTRUE_JWT_DEFAULT_GROUP_NAME": "authenticated",
    "GOTRUE_JWT_EXP": "900",
    "GOTRUE_JWT_ISSUER": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1",
    "GOTRUE_JWT_SECRET": "jwt-secret-for-the-golden-test",
    "GOTRUE_LOG_LEVEL": "warn",
    "GOTRUE_MAILER_AUTOCONFIRM": "true",
    "GOTRUE_MAILER_URLPATHS_CONFIRMATION": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_INVITE": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify",
    "GOTRUE_MAILER_URLPATHS_RECOVERY": "https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify",
    "GOTRUE_SITE_URL": "https://app.example.com"
  },
  "Limits": {
    "memory_max": "1G",
    "cpu_quota": "100%"
  },
  "Exec": null,
  "Log": "",
  "PreStart": [
    [
      "bin/auth",
      "migrate"
    ]
  ],
  "PublicRun": false,
  "DenyEgress": false
}
--- env
API_EXTERNAL_URL="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1"
DATABASE_URL="postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:20033/postgres?sslmode=disable"
GOTRUE_API_HOST="127.0.0.1"
GOTRUE_API_PORT="20034"
GOTRUE_DB_DATABASE_URL="postgres://supabase_auth_admin:auth-admin-password@127.0.0.1:20033/postgres?sslmode=disable"
GOTRUE_DB_DRIVER="postgres"
GOTRUE_DISABLE_SIGNUP="false"
GOTRUE_EXTERNAL_EMAIL_ENABLED="true"
GOTRUE_JWT_ADMIN_ROLES="service_role"
GOTRUE_JWT_AUD="authenticated"
GOTRUE_JWT_DEFAULT_GROUP_NAME="authenticated"
GOTRUE_JWT_EXP="900"
GOTRUE_JWT_ISSUER="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1"
GOTRUE_JWT_SECRET="jwt-secret-for-the-golden-test"
GOTRUE_LOG_LEVEL="warn"
GOTRUE_MAILER_AUTOCONFIRM="true"
GOTRUE_MAILER_URLPATHS_CONFIRMATION="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_INVITE="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify"
GOTRUE_MAILER_URLPATHS_RECOVERY="https://zyxwvutsrqponmlkjihg.api.example.test/auth/v1/verify"

{
  "compilerOptions": { "strict": true, "lib": ["deno.window"] },
  "lint": {
    "include": ["index.ts", "src/"],
    "rules": { "tags": ["recommended"] }
  },
  "fmt": {
    "include": ["index.ts", "src/"],
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "tasks": {
    "check": "deno check index.ts src/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "test": "deno test --allow-read --allow-write --allow-env --no-check=remote src/"
  }
}

[Unit]
Description=sbctl Realtime, the shared multi-tenant websocket server
Documentation=https://github.com/OWNER/sbctl
Requires=sb-postgres@system.service
After=network.target local-fs.target sb-postgres@system.service
StartLimitIntervalSec=0

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/system/realtime.env
ExecStart=/var/lib/sbctl/projects/system/realtime.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-realtime

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The EC2 instance role (backup bucket, DNS) must not reach tenant-facing code through the
# instance metadata service (IPv4 and IPv6 addresses). Only sbctl.service holds credentials.
IPAddressDeny=169.254.169.254 fd00:ec2::254
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=-/var/lib/sbctl/system/realtime
# Containment (allowlist). Every unit runs as the sbctl user, so the mount namespace is
# what keeps a service away from the master key, other projects' data and the backups. The
# unit sees an empty tmpfs where /var/lib/sbctl is, plus the artifacts (read-only), its own
# launcher script (read-only) and its own state directory. It never needs to read an
# environment file: systemd reads EnvironmentFile= before it builds the namespace. This
# does not isolate tenants from a compromised service (same uid, /proc); see README.md.
InaccessiblePaths=-/etc/sbctl
TemporaryFileSystem=/var/lib/sbctl:ro
BindReadOnlyPaths=/var/lib/sbctl/artifacts /var/lib/sbctl/projects/system/realtime.run
BindPaths=-/var/lib/sbctl/system/realtime

[Install]
WantedBy=multi-user.target

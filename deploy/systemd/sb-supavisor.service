[Unit]
Description=sbctl Supavisor, the shared Postgres pooler
Documentation=https://github.com/OWNER/sbctl
Requires=sb-postgres@system.service
After=network.target local-fs.target sb-postgres@system.service
StartLimitIntervalSec=0

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/system/supavisor.env
ExecStart=/var/lib/sbctl/projects/system/supavisor.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-supavisor

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/sbctl/projects/system /var/lib/sbctl/system
# Containment: every unit runs as the sbctl user, so without this a compromised service
# could read the master key and every other project's files (and, through the unix
# socket that pg_hba.conf trusts for supabase_admin, every cluster). Hide /etc/sbctl and
# all project directories but this unit's own, and the cluster directory (socket, root
# key) of that one too: these services reach Postgres over TCP. The residual risk is documented in
# deploy/systemd/README.md.
InaccessiblePaths=-/etc/sbctl -/var/lib/sbctl/projects/system/postgres
TemporaryFileSystem=/var/lib/sbctl/projects:ro
BindPaths=/var/lib/sbctl/projects/system

[Install]
WantedBy=multi-user.target

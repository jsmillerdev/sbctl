[Unit]
Description=Supavise removal of the Edge Function bundler's module cache of project %i
Documentation=https://github.com/supavise/supavise

[Service]
# Started by supavise when it deletes project <ref> (units.Systemd.Remove), after it has stopped
# supavise-edge-bundle@<ref>.service. The module cache of that unit (CacheDirectory=supavise-edge-bundle/%i)
# is private to its dynamic uid under /var/cache/private, which only root may enter, so the
# supavise user cannot delete it. systemd can ("systemctl clean --what=cache"), but the D-Bus
# policy of systemd does not let a user other than root call CleanUnit, so this unit does the
# same removal as root and is as narrow as it can be: it takes the project ref from its own name,
# refuses anything but lowercase letters (no "..", no "/"), and may write nowhere but under
# /var/cache/private/supavise-edge-bundle. The polkit rule of supavise (manage-units on supavise-* units) is
# what lets the supavise user start it. It reads nothing from the project and runs no tenant code.
Type=oneshot
Slice=supavise.slice
ExecStart=/bin/sh -c 'case "$$1" in ""|*[!a-z]*) echo "not a project ref: $$1" >&2; exit 2;; esac; rm -rf -- "/var/cache/private/supavise-edge-bundle/$$1"' sh %i
TimeoutStartSec=120s
SyslogIdentifier=supavise-edge-bundle-clean

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
# Root needs to open and delete files that belong to another uid, and nothing else.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
AmbientCapabilities=
UMask=0077
ReadWritePaths=-/var/cache/private/supavise-edge-bundle

# Never enabled: supavise starts an instance when it deletes a project.

[Unit]
Description=sbctl PostgREST for project %i
Documentation=https://github.com/OWNER/sbctl
Requires=sb-postgres@%i.service
After=network.target local-fs.target sb-postgres@%i.service
StartLimitIntervalSec=0

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/%i/postgrest.env
ExecStart=/var/lib/sbctl/projects/%i/postgrest.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-postgrest@%i

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/sbctl/projects/%i/postgrest
# Containment (allowlist). Every unit runs as the sbctl user, so the mount namespace is
# what keeps a service away from the master key, other projects' data and the backups. The
# unit sees an empty tmpfs where /var/lib/sbctl is, plus the artifacts (read-only), its own
# launcher script (read-only) and its own state directory. It never needs to read an
# environment file: systemd reads EnvironmentFile= before it builds the namespace. This
# does not isolate tenants from a compromised service (same uid, /proc); see README.md.
InaccessiblePaths=-/etc/sbctl
TemporaryFileSystem=/var/lib/sbctl:ro
BindReadOnlyPaths=/var/lib/sbctl/artifacts /var/lib/sbctl/projects/%i/postgrest.run
BindPaths=/var/lib/sbctl/projects/%i/postgrest

[Install]
WantedBy=multi-user.target

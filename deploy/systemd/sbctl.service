[Unit]
Description=sbctl control plane (Management API, proxy, lifecycle, WAL archiver)
Documentation=https://github.com/OWNER/sbctl
After=network-online.target sb-postgres@system.service
Wants=network-online.target sb-postgres@system.service sb-gotrue@system.service

[Service]
Type=simple
User=sbctl
Group=sbctl
Slice=sbctl.slice
# `sbctl serve` is provided by the API and proxy workstreams.
ExecStart=/usr/local/bin/sbctl serve
Restart=always
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
SyslogIdentifier=sbctl

# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
# sbctl writes project state, env files and run scripts under the state directory.
# systemd itself writes unit drop-ins when sbctl asks over D-Bus.
ReadWritePaths=/var/lib/sbctl

[Install]
WantedBy=multi-user.target

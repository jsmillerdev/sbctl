[Unit]
Description=Supavise control plane (Management API, proxy, lifecycle, WAL archiver)
Documentation=https://github.com/jsmillerdev/supavise
After=network-online.target supavise-postgres@system.service
Wants=network-online.target supavise-postgres@system.service supavise-gotrue@system.service
# The daemon waits for the registry itself (up to 2 minutes), and Restart= must never
# end in start-limit-hit: a stopped control plane after a reboot is worse than a loop.
StartLimitIntervalSec=0

[Service]
Type=simple
User=supavise
Group=supavise
Slice=supavise.slice
# `supavise serve` runs the Management API, the edge proxy and the lifecycle engine; it
# starts every active project at boot and stops on SIGTERM (project units keep running).
ExecStart=/usr/local/bin/supavise serve
Restart=always
RestartSec=2s
# On SIGTERM the daemon refuses new lifecycle operations and waits up to 10 minutes
# (app.StopBudget) for running ones (a delete with its final backup, a restart) before it
# exits, so `systemctl restart supavise` and self-update can take that long. An operation cut
# off anyway is finished or reverted by the next start.
TimeoutStopSec=660
LimitNOFILE=65536
SyslogIdentifier=supavise

# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
# supavise writes project state, env files and run scripts under the state directory.
# systemd itself writes unit drop-ins when supavise asks over D-Bus.
ReadWritePaths=/var/lib/supavise

[Install]
WantedBy=multi-user.target

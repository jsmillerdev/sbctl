[Unit]
Description=sbctl Studio, the dashboard
Documentation=https://github.com/OWNER/sbctl
After=network.target local-fs.target 
StartLimitIntervalSec=0

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/system/studio.env
ExecStart=/var/lib/sbctl/projects/system/studio.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-studio

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Studio rewrites its runtime-config templates and Next's image cache inside its artifact
# directory at every start, so that one directory is writable (studio/README.md).
ReadWritePaths=-/var/lib/sbctl/system/studio /var/lib/sbctl/artifacts/studio
# Containment (allowlist). Every unit runs as the sbctl user, so the mount namespace is
# what keeps a service away from the master key, other projects' data and the backups. The
# unit sees an empty tmpfs where /var/lib/sbctl is, plus the artifacts (read-only), its own
# launcher script (read-only) and its own state directory. It never needs to read an
# environment file: systemd reads EnvironmentFile= before it builds the namespace. This
# does not isolate tenants from a compromised service (same uid, /proc); see README.md.
InaccessiblePaths=-/etc/sbctl
TemporaryFileSystem=/var/lib/sbctl:ro
BindReadOnlyPaths=/var/lib/sbctl/artifacts /var/lib/sbctl/projects/system/studio.run
BindPaths=-/var/lib/sbctl/system/studio /var/lib/sbctl/artifacts/studio

[Install]
WantedBy=multi-user.target

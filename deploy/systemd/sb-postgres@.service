[Unit]
Description=sbctl Postgres for project %i
Documentation=https://github.com/OWNER/sbctl
After=network.target local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5
# Enabled for boot before the project exists (system project): skip until rendered.
ConditionPathExists=/var/lib/sbctl/projects/%i/postgres.run

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/%i/postgres.env
ExecStart=/var/lib/sbctl/projects/%i/postgres.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=90
LimitNOFILE=16384
OOMScoreAdjust=-500
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-postgres@%i
# SIGINT is Postgres's fast shutdown: abort open transactions, checkpoint, exit.
# systemd sends it to the postmaster only, and SIGKILL to what is left on timeout.
KillMode=mixed
KillSignal=SIGINT

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# The local backup backend (file://) writes WAL from archive_command into backups/<ref>/,
# which sbctl creates before the first start. The launcher chmods a script inside the
# postgres artifact on first boot, so that one artifact directory is writable too.
ReadWritePaths=/var/lib/sbctl/projects/%i/postgres /var/lib/sbctl/artifacts/postgres -/var/lib/sbctl/backups/%i
# Containment (allowlist). Every unit runs as the sbctl user, so the mount namespace is
# what keeps this cluster away from the master key, other projects' data and other
# projects' backups. The unit sees an empty tmpfs where /var/lib/sbctl is, plus the
# artifacts (read-only, the postgres one writable), its launcher script, its own cluster
# directory and its own backup directory. The master key is hidden: archive_command
# (`sbctl wal push`) reads only config.toml. Environment files are read by systemd before
# the namespace exists. This does not isolate tenants from a compromised cluster (same
# uid, /proc); see README.md.
# Three unix sockets the IP filter of a branch with denied egress (IPAddressDeny, set per unit over
# D-Bus) cannot cover and that systemd 255 does not let a running unit's InaccessiblePaths change over
# D-Bus, so every Postgres unit hides them: the resolver's varlink socket (glibc's nss-resolve; a
# Postgres without it falls back to /etc/resolv.conf), the D-Bus system bus (a polkit rule of
# sbctl's would let a confined unit lift its own filter) and nscd's socket.
InaccessiblePaths=-/etc/sbctl/master.key -/run/systemd/resolve/io.systemd.Resolve -/run/dbus/system_bus_socket -/run/nscd/socket
TemporaryFileSystem=/var/lib/sbctl:ro
BindReadOnlyPaths=/var/lib/sbctl/artifacts /var/lib/sbctl/projects/%i/postgres.run
BindPaths=/var/lib/sbctl/projects/%i/postgres /var/lib/sbctl/artifacts/postgres -/var/lib/sbctl/backups/%i

[Install]
WantedBy=multi-user.target

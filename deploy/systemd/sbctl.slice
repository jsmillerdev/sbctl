[Unit]
Description=sbctl projects and shared services
Documentation=https://github.com/OWNER/sbctl
Before=slices.target

[Slice]
# Every sbctl unit runs here. Limits are set per unit (MemoryMax, CPUQuota) from the
# project record, not on the slice, so one project cannot starve another and the slice
# stays a single place to read total usage: systemctl status sbctl.slice
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes

[Unit]
Description=sbctl base backup and retention for project %i
After=sb-postgres@%i.service

[Service]
Type=oneshot
User=sbctl
Group=sbctl
Slice=sbctl.slice
# SBCTL_REGISTRY_DSN (and any other SBCTL_* override) for processes outside the daemon.
EnvironmentFile=-/etc/sbctl/sbctl.env
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/sbctl backups create %i --reason scheduled
ExecStart=/usr/local/bin/sbctl backups prune %i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

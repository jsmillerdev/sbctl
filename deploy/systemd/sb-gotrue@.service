[Unit]
Description=sbctl GoTrue for project %i
Documentation=https://github.com/OWNER/sbctl
Requires=sb-postgres@%i.service
After=network.target local-fs.target sb-postgres@%i.service
StartLimitIntervalSec=0
# Enabled for boot before the project exists (system project): skip until rendered.
ConditionPathExists=/var/lib/sbctl/projects/%i/gotrue.run

[Service]
# sbctl renders the two files below (units.Supervisor.Render) before it starts the unit.
Type=exec
User=sbctl
Group=sbctl
Slice=sbctl.slice
EnvironmentFile=/var/lib/sbctl/projects/%i/gotrue.env
ExecStart=/var/lib/sbctl/projects/%i/gotrue.run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30
LimitNOFILE=65536
# MemoryMax and CPUQuota come from the project record: sbctl applies them over D-Bus
# as persistent per-unit drop-ins.
MemoryAccounting=yes
CPUAccounting=yes
SyslogIdentifier=sb-gotrue@%i

# Hardening. MemoryDenyWriteExecute is deliberately absent: Postgres (JIT), the BEAM
# and Node all map writable+executable memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/sbctl/projects/%i
# Containment: every unit runs as the sbctl user, so without this a compromised service
# could read the master key, every project's data (including backups) and the TLS keys.
# The unit sees only the artifacts (read-only) and its own state. Everything else under
# /var/lib/sbctl (backups, certs, run, logs, other projects, other services' state) is
# replaced by an empty tmpfs, /etc/sbctl is hidden, and so are the env files of sibling
# services and the cluster directory (socket, root key): these services reach Postgres
# over TCP. The residual risk is documented in deploy/systemd/README.md.
InaccessiblePaths=-/etc/sbctl -/var/lib/sbctl/projects/%i/postgres -/var/lib/sbctl/projects/%i/postgres.env -/var/lib/sbctl/projects/%i/postgrest.env
TemporaryFileSystem=/var/lib/sbctl:ro
BindReadOnlyPaths=/var/lib/sbctl/artifacts
BindPaths=/var/lib/sbctl/projects/%i

[Install]
WantedBy=multi-user.target
